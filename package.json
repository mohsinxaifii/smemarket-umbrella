{
  "name": "smemarket-umbrella",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-peeps.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-peeps.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:pages": "rm -rf out && node scripts/build-peeps.mjs && STATIC_EXPORT=1 node scripts/build-images.mjs && STATIC_EXPORT=1 next build",
    "api": "wrangler d1 migrations apply smemarket --local && wrangler pages dev out --port 8788",
    "db:migrate": "wrangler d1 migrations apply smemarket --remote",
    "local": "node scripts/local.mjs",
    "local:reset": "node scripts/local.mjs --reset"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "lenis": "^1.3.4",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-peeps": "^0.1.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^3.114.17"
  }
}
